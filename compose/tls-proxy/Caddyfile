{
	# off = no ACME, no HTTP redirect (avoids bind :80)
	auto_https off
}
# TLS reverse proxy - :8443 (hello-world), :8444 (n8n), :8445 (tic-tac-toe), :8446 (claude-mock-test),
# :8447 (litellm), :8448 (weather-mcp), :8449 (wordpress), :9443 (cockpit)
# :8097 is the loopback-only public front for wordpress, served by Cloudflare Tunnel
# (NOT Tailscale Funnel — Funnel can't serve a custom domain). See the :8097 block below.
# :8090 is a loopback-only, plain-HTTP tailnet path router
# (cockpit/tictactoe/helloworld/claudemock/weather).
# :8092 is litellm's dedicated tailnet-only port (root-mounted — see the :8092 block below
# for why it can't be path-mounted on :8090). See docs/NETWORK-CONFIG.md.
# New ":PORT {" sites here are picked up by scripts/setup-windows-podman-lan-ports.ps1 on Windows.
#
# Three address forms appear below and they are NOT interchangeable:
#   bind 127.0.0.1          - a Caddy listener only tailscaled (on this host) should reach.
#   reverse_proxy {env.HOST_INTERNAL_IP}:PORT
#                           - a container backend published under p-open-east-west
#                             (architecture/model.yaml). The address is PER-HOST and comes
#                             from HOST_INTERNAL_IP in .env, passed into this container by
#                             compose/tls-proxy/compose.yaml:
#                               beeblebox (native Linux, rootless podman + pasta) -> 127.0.0.1,
#                                 reachable from containers only because pasta is configured
#                                 with --map-host-loopback (see docs/NETWORK-CONFIG.md);
#                               WSL2 hosts -> 10.255.255.254, WSL's host address on lo.
#                             Never hardcode either value here: they differ per host and
#                             Caddy has no shell-style ${VAR} substitution, only {env.VAR}.
#   reverse_proxy 127.0.0.1:PORT
#                           - a backend that is NOT a migrated container publish: cockpit
#                             (:9090) is a host service, and hello-world (:8080) / n8n
#                             (:5678) still publish on 0.0.0.0.
:8443 {
  bind 0.0.0.0
  tls /certs/server.pem /certs/server-key.pem
  reverse_proxy 127.0.0.1:8080
}
:8444 {
  bind 0.0.0.0
  tls /certs/server.pem /certs/server-key.pem
  reverse_proxy 127.0.0.1:5678
}
:8445 {
  bind 0.0.0.0
  tls /certs/server.pem /certs/server-key.pem
  reverse_proxy {env.HOST_INTERNAL_IP}:8091
}
:8446 {
  bind 0.0.0.0
  tls /certs/server.pem /certs/server-key.pem
  reverse_proxy {env.HOST_INTERNAL_IP}:8093
}
:8447 {
  bind 0.0.0.0
  tls /certs/server.pem /certs/server-key.pem
  reverse_proxy {env.HOST_INTERNAL_IP}:4000 {
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {hostport}
    header_up Host {hostport}
    # LiteLLM may redirect to http://127.0.0.1:4000 or omit the TLS port
    header_down Location http:// https://
    header_down Location "http://127.0.0.1:4000" "https://{hostport}"
    header_down Location "https://127.0.0.1/" "https://127.0.0.1:8447/"
    header_down Location "https://localhost/" "https://localhost:8447/"
  }
}
:8448 {
  bind 0.0.0.0
  tls /certs/server.pem /certs/server-key.pem
  reverse_proxy {env.HOST_INTERNAL_IP}:8094
}
:8449 {
  bind 0.0.0.0
  tls /certs/server.pem /certs/server-key.pem
  reverse_proxy {env.HOST_INTERNAL_IP}:8096
}
:9443 {
  bind 0.0.0.0
  tls /certs/server.pem /certs/server-key.pem
  reverse_proxy 127.0.0.1:9090
}

# Tailnet-only path router. Loopback-only — not a LAN front door. Mounted at the
# tailnet leg via: tailscale serve --bg --https=8090 http://127.0.0.1:8090
# Plain HTTP by design: Tailscale terminates TLS for tailnet clients.
# The public :443 Funnel has been torn down (VPN-only access now) — tictactoe was
# moved here from its old Funnel path mount; see docs/NETWORK-CONFIG.md.
:8090 {
  bind 127.0.0.1

  redir /cockpit /cockpit/
  redir /tictactoe /tictactoe/
  redir /helloworld /helloworld/
  redir /claudemock /claudemock/
  redir /weather /weather/

  # No strip: Cockpit's own asset scheme uses "/cockpit/$checksum/..." as an internal
  # path convention — stripping the prefix here would break it. Requires UrlRoot=/cockpit
  # in /etc/cockpit/cockpit.conf (see scripts/sudo/setup-cockpit.sh).
  handle /cockpit/* {
    reverse_proxy 127.0.0.1:9090
  }
  # Strip is fine here: tic-tac-toe's frontend derives its API base from
  # location.pathname (see compose/tic-tac-toe/templates/index.html's BASE constant).
  handle_path /tictactoe/* {
    reverse_proxy {env.HOST_INTERNAL_IP}:8091
  }
  # Strip is fine here: the weather GUI derives its API base from location.pathname
  # the same way (see compose/weather-mcp/templates/index.html's BASE constant).
  # Tailnet-only on purpose: the GUI and its /api/* routes are unauthenticated and
  # /api/city-coordinates proxies nominatim.openstreetmap.org, which is why the
  # public :443/weather Funnel still serves only the :8095 allowlist below. Note the
  # two mounts share a path name on different ports: :443/weather is MCP-only and
  # public, :8090/weather is the GUI and tailnet-only.
  handle_path /weather/* {
    reverse_proxy {env.HOST_INTERNAL_IP}:8094
  }
  # Strip is fine here: hello-world serves nginx's stock default page (no root-absolute
  # asset paths to break).
  handle_path /helloworld/* {
    reverse_proxy 127.0.0.1:8080
  }
  # Strip is fine here: the mock test is a static bundle whose asset references are all
  # relative, and it makes no HTTP calls at all (state lives in localStorage) — verified
  # by grep before mounting, as docs/NETWORK-CONFIG.md requires.
  handle_path /claudemock/* {
    reverse_proxy {env.HOST_INTERNAL_IP}:8093
  }
  # n8n is NOT here — its registered webhook/MCP URLs (e.g. /mcp/<id>, /webhook/<id>) must
  # keep their exact path, and N8N_PATH is a whole-process setting (see "n8n: intentionally
  # excluded" in docs/NETWORK-CONFIG.md) — a prefix strip or redirect would break
  # already-registered callers. It's root-funneled on the public :443 port instead
  # (also required for external MCP connector infra to reach it — see docs).
  # litellm is NOT here either — its admin UI is a Next.js SPA whose API calls
  # (/key/list, /global/activity, etc.) are hardcoded root-relative with no configurable
  # base path, so a /litellm sub-path mount can serve the shell but never load real data.
  # It gets its own dedicated tailnet-only port instead: see the :8092 block below.

  handle {
    root * /srv/router
    file_server
  }
}

# litellm admin UI: dedicated tailnet-only port, root-mounted (see the note in the :8090
# block above for why litellm can't be path-mounted). Mirrors the LAN :8447 site's
# Location-header rewriting, adjusted for this port. Mounted at the tailnet leg via:
# tailscale serve --bg --https=8092 http://127.0.0.1:8092
# Plain HTTP by design: Tailscale terminates TLS for tailnet clients (same as :8090).
:8092 {
  bind 127.0.0.1
  reverse_proxy {env.HOST_INTERNAL_IP}:4000 {
    header_up X-Forwarded-Proto https
    header_up X-Forwarded-Host {hostport}
    header_up Host {hostport}
    # LiteLLM may redirect to http://127.0.0.1:4000 or omit the TLS port
    header_down Location http:// https://
    header_down Location "http://127.0.0.1:4000" "https://beeblebox.taile98462.ts.net:8092"
    header_down Location "https://127.0.0.1/" "https://beeblebox.taile98462.ts.net:8092/"
    header_down Location "https://localhost/" "https://beeblebox.taile98462.ts.net:8092/"
  }
}

# Public front for the weather MCP server. The Tailscale Funnel mounts
# :443/weather here, NOT straight at 127.0.0.1:8094, because only part of the app
# is safe to publish: the app's bearer/OAuth check wraps only the /mcp mount, so
# the Flask GUI and its /api/* routes are unauthenticated - and
# /api/city-coordinates proxies to nominatim.openstreetmap.org, whose usage policy
# bans abusive IPs. Publishing them would make this host an open geocoding proxy.
# The GUI stays reachable on the LAN via the :8448 site above, and on the tailnet
# via /weather on the :8090 path router.
# Plain HTTP by design: Tailscale terminates TLS for funnel clients (same as :8090).
# Mounted at the public leg via:
#   tailscale funnel --bg --https=443 --set-path=/weather http://127.0.0.1:8095
:8095 {
  bind 127.0.0.1

  # MCP transport, the OAuth 2.1 authorization-server endpoints, the /login hop
  # that completes the flow, RFC 8414/9728 discovery, and the health probe.
  @published path /mcp /mcp/* /health /login /authorize /token /register /revoke /.well-known/*
  handle @published {
    reverse_proxy {env.HOST_INTERNAL_IP}:8094
  }

  handle {
    respond 404
  }
}

# Public front for WordPress (thelearningcto.com). Cloudflare Tunnel connects here:
#   /etc/cloudflared/config.yml ingress -> http://127.0.0.1:8097
# Plain HTTP by design: Cloudflare terminates TLS at the edge — same convention as :8090
# and :8095, where Tailscale terminates instead. Cloudflare Tunnel rather than Funnel
# because Funnel can only ever serve beeblebox.taile98462.ts.net, not a custom domain.
#
# Unlike :8095 (weather), this is deliberately NOT an allowlist — a blog is meant to be
# wholly public. Two carve-outs:
#   - /xmlrpc.php blocked outright: nothing here uses it, and it's a standing
#     brute-force and pingback-amplification target.
#   - /wp-admin and /wp-login.php are deliberately NOT blocked here. They're gated at the
#     Cloudflare edge by Access (team tight-sun-921f) instead, because WordPress
#     canonical-redirects every admin URL to WP_SITEURL — serving admin on a different
#     hostname makes the login form post back to the public URL and fail. Same class of
#     problem as litellm's hardcoded root paths, but redirects rather than assets.
:8097 {
  bind 127.0.0.1

  handle /xmlrpc.php {
    respond 403
  }

  # /wp-admin/* and /wp-login.php are intentionally NOT blocked here — they are gated at
  # the Cloudflare edge by Access (team tight-sun-921f), verified 2026-08-30: both return
  # 302 to tight-sun-921f.cloudflareaccess.com before ever reaching this origin. Blocking
  # them here as well would break login for users Access has already authenticated.
  handle {
    reverse_proxy {env.HOST_INTERNAL_IP}:8096 {
      # Hardcoded https, not {scheme}: this site is plain HTTP, so {scheme} would say
      # "http" and overwrite the header Cloudflare set — and wp-config.php keys its
      # $_SERVER['HTTPS'] fix off exactly this header. Getting it wrong is an infinite
      # redirect loop against WP_SITEURL. Same reasoning as the :8092 litellm block.
      header_up X-Forwarded-Proto https
      header_up Host {host}
    }
  }
}
