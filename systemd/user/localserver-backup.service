[Unit]
Description=Off-box backup of Podman databases and secrets to Azure Blob
Documentation=https://github.com/darraghog/localserver-config
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__REPO_ROOT__/scripts/backup.sh

# Deliberately NO [Install] section: this unit is driven by localserver-backup.timer.
# Giving it WantedBy=default.target would run a full backup on every boot.
