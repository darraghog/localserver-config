[Unit]
Description=Daily homelab-arch export publish and drift report (see localserver-homelab-arch-export-sync.service)
Documentation=https://github.com/darraghog/localserver-config

[Timer]
# Daily at 09:00 on the server's clock. Persistent=true means a run missed while the host was off
# fires shortly after it next boots rather than being skipped for the day.
OnCalendar=*-*-* 09:00:00
Persistent=true
RandomizedDelaySec=5min
Unit=localserver-homelab-arch-export-sync.service

[Install]
WantedBy=timers.target
