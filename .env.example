# Copy to .env and fill in values before deploying.
# .env is gitignored — never commit it.

# Host-internal bind address for published service ports (required).
# Every stack publishes as "${HOST_INTERNAL_IP}:<host-port>:<container-port>" so the endpoint
# is reachable from the host and from every other container, but not from the LAN or tailnet.
# See p-open-east-west in architecture/model.yaml and docs/NETWORK-CONFIG.md.
#
# THE VALUE IS PER-HOST:
#   native Linux, rootless podman + pasta  -> 127.0.0.1
#       (requires podman/containers.conf's --map-host-loopback; without it, containers
#        cannot reach host loopback at all)
#   WSL2                                   -> 10.255.255.254
#       (WSL's global address on lo: container-reachable, not LAN-routable)
# Never use 0.0.0.0: it also publishes the port on the LAN and the tailnet.
HOST_INTERNAL_IP=10.255.255.254

# n8n admin password (required)
N8N_BASIC_AUTH_PASSWORD=

# n8n encryption key for stored credentials (required)
# Generate with: openssl rand -hex 32
# WARNING: if you lose this key, all saved credentials in n8n become unrecoverable
N8N_ENCRYPTION_KEY=

# Postgres password (only needed if enabling the Postgres service in compose/n8n/compose.yaml)
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# LiteLLM — proxy auth, UI login, and public URL (required for Admin UI + HTTPS links)
# LITELLM_MASTER_KEY must start with sk- (generate: echo "sk-$(openssl rand -hex 24)")
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
# Admin UI login — use your WSL/Linux username and login password
LITELLM_UI_USERNAME=
LITELLM_UI_PASSWORD=
# External HTTPS URL (must match Caddy port in compose/tls-proxy/Caddyfile)
LITELLM_PROXY_BASE_URL=https://localhost:8447
# Default SSH target for `./scripts/deploy-litellm.sh prod` when no host is given on the
# command line. Leave blank to require `deploy-litellm.sh prod <hostname>` explicitly.
LITELLM_PROD_HOST=

# LiteLLM — cloud provider API keys (reference in compose/litellm/config.yaml as os.environ/VAR)
# Leave blank when using Ollama-only models. Get keys from each provider's developer console.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# n8n workflow app env (Shakespeare Play Explorer). Also set in this file
# so compose/n8n/compose.yaml can pass them into the n8n container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
SMTP_FROM_EMAIL=
OPERATOR_EMAIL=
EMAIL_ALLOWLIST=
EVAL_WEBHOOK_TOKEN=

# --- weather-mcp ---------------------------------------------------------
# Shared secret for the weather MCP server. Used two ways at once: the static
# bearer accepted on /mcp, and the password checked at /login to complete the
# OAuth 2.1 flow. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEATHER_MCP_TOKEN=
# Public base URL INCLUDING the funnel path prefix. Must byte-for-byte match the
# tailscale --set-path mount: the OAuth issuer, the protected-resource metadata
# and the /login redirect are all derived from it.
#   prod:  https://beeblebox.taile98462.ts.net/weather
#   local: http://localhost:8094
WEATHER_MCP_ISSUER_URL=

# --- wordpress (thelearningcto.com) ---------------------------------------
# Database credentials for the WordPress stack (compose/wordpress/compose.yaml).
# Generate each with: openssl rand -hex 20
WORDPRESS_DB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# --- backups -------------------------------------------------------------
# Backup credentials are deliberately NOT here. They live outside the repo in
# ~/.config/localserver/backup.env (chmod 600) because they include RESTIC_PASSWORD,
# which decrypts every backup — including this file. See docs/BACKUP.md.
#   AZURE_ACCOUNT_NAME / AZURE_ACCOUNT_KEY / RESTIC_REPOSITORY / RESTIC_PASSWORD
#
# backup.sh reads MARIADB_ROOT_PASSWORD and POSTGRES_PASSWORD from THIS file to take dumps.
