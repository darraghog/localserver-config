# Copy to .env and fill in values before deploying.
# .env is gitignored — never commit it.

# n8n admin password (required)
N8N_BASIC_AUTH_PASSWORD=

# n8n encryption key for stored credentials (required)
# Generate with: openssl rand -hex 32
# WARNING: if you lose this key, all saved credentials in n8n become unrecoverable
N8N_ENCRYPTION_KEY=

# Postgres password (only needed if enabling the Postgres service in compose/n8n/compose.yaml)
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# LiteLLM — proxy auth, UI login, and public URL (required for Admin UI + HTTPS links)
# LITELLM_MASTER_KEY must start with sk- (generate: echo "sk-$(openssl rand -hex 24)")
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
# Admin UI login — use your WSL/Linux username and login password
LITELLM_UI_USERNAME=
LITELLM_UI_PASSWORD=
# External HTTPS URL (must match Caddy port in compose/tls-proxy/Caddyfile)
LITELLM_PROXY_BASE_URL=https://localhost:8447

# LiteLLM — cloud provider API keys (reference in compose/litellm/config.yaml as os.environ/VAR)
# Leave blank when using Ollama-only models. Get keys from each provider's developer console.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
