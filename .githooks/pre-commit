#!/usr/bin/env bash
# Validate the architecture before a commit that could invalidate it: scripts/arch-validate.py until
# the N5 cutover commits architecture/export.json, then the pinned scripts/arch-check.sh.
#
# Catches model drift at commit time; scripts/lib/stack-helpers.sh's require_conformant_model()
# is the real gate and blocks the deploy itself. This hook is the early, cheap warning.
#
# Enable once per clone:  git config core.hooksPath .githooks
# (scripts/sudo/bootstrap-host.sh does this for you.)
# Bypass for a work-in-progress commit:  git commit --no-verify
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Validate the Prometheus and Alertmanager configs (rules, unit tests, amtool) when they are staged.
# Skipped, with a notice, when podman is unavailable. Runs before the model check so that check's
# early exits never bypass it.
check_monitoring_configs() {
  git diff --cached --name-only | grep -qE '^compose/(prometheus|alertmanager)/' || return 0
  if ! command -v podman &>/dev/null; then
    echo "[pre-commit] podman not found; skipping promtool/amtool validation." >&2
    return 0
  fi
  local prom_img="docker.io/prom/prometheus:v3.5.0" am_img="docker.io/prom/alertmanager:v0.28.1"
  local rc=0
  # Mounted at /etc/prometheus because prometheus.yml references /etc/prometheus/rules/*.yml.
  podman run --rm -v "$REPO_ROOT/compose/prometheus:/etc/prometheus:ro" --entrypoint promtool "$prom_img" \
    check config /etc/prometheus/prometheus.yml || rc=1
  podman run --rm -v "$REPO_ROOT/compose/prometheus:/etc/prometheus:ro" --entrypoint promtool "$prom_img" \
    test rules /etc/prometheus/tests/alerts.test.yml || rc=1
  podman run --rm -v "$REPO_ROOT/compose/alertmanager:/w:ro" --entrypoint amtool "$am_img" \
    check-config /w/alertmanager.yml || rc=1
  if [[ "$rc" -ne 0 ]]; then
    echo "" >&2
    echo "[pre-commit] promtool/amtool validation failed - commit refused." >&2
    echo "[pre-commit] Fix the config, or commit with --no-verify if this is a WIP commit." >&2
    return 1
  fi
}

check_monitoring_configs || exit 1

# Only worth running when something that shapes the model is staged.
if ! git diff --cached --name-only | grep -qE '^(architecture/|compose/|systemd/|scripts/arch-(check|validate|export)\.)'; then
  exit 0
fi

if [[ ! -f "$REPO_ROOT/architecture/model.yaml" ]]; then
  exit 0
fi

# Switch-over: until the N5 cutover commits a generated architecture/export.json, the stdlib
# validator (the same one the deploy gate uses) stays the check, as before. Once
# architecture/export.json is in the INDEX or in HEAD (an untracked trial file does not count; a
# commit that deletes a committed export.json still counts), the pinned scripts/arch-check.sh runs
# instead. With no HEAD (fresh repo) the HEAD test fails quietly and the old path applies. Note
# that arch-check.sh itself reads the working tree.
if git cat-file -e ":architecture/export.json" 2>/dev/null \
  || git cat-file -e "HEAD:architecture/export.json" 2>/dev/null; then
  if ! "$REPO_ROOT/scripts/arch-check.sh"; then
    echo "" >&2
    echo "[pre-commit] architecture checks failed (pinned checker: scripts/arch-check.sh) — commit refused." >&2
    echo "[pre-commit] Fix the model, or run scripts/arch-export.sh and commit its output together with" >&2
    echo "[pre-commit] the provisioning YAML; --no-verify is for WIP commits only." >&2
    exit 1
  fi
  exit 0
fi

if ! command -v python3 &>/dev/null; then
  echo "[pre-commit] python3 not found; skipping architecture validation." >&2
  exit 0
fi

if ! python3 "$REPO_ROOT/scripts/arch-validate.py"; then
  echo "" >&2
  echo "[pre-commit] architecture/model.yaml does not conform — commit refused." >&2
  echo "[pre-commit] Fix the model, or commit with --no-verify if this is a WIP commit." >&2
  exit 1
fi
