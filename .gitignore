certs/
.env
envs/
libpod/
# Vendor-supplied GQLDB Manager package. No apt source and the upstream repo is private,
# so this is the only copy - but it is ~150MB and does not belong in git. Its sha256 is
# recorded in compose/gqldb/manager.deb.sha256, which IS tracked.
compose/gqldb/*.deb

# Ephemeral venv for compose/*/build.sh (e.g. tic-tac-toe tests)
compose/*/.build/
__pycache__/
*.py[cod]

# Stale worktree snapshots from agent sessions - never track these.
.claude/worktrees/


# Per-machine Claude Code permissions - never track these.
.claude/settings.local.json

# Rendered from cloudflared/config.yml.in by scripts/sudo/bootstrap-host.sh (contains $HOME).
cloudflared/config.yml

# Generated by scripts/emit-unit-metrics.sh on the host; node-exporter's textfile collector reads it.
compose/prometheus/textfile/*.prom
